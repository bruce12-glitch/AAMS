# TLS termination for AAMS (see SECURITY.md).
# Enable with:  docker compose --profile tls up -d
# Point DNS at this host; Caddy obtains/renews certificates automatically.

lab.example.edu {
    encode zstd gzip

    # Console
    handle {
        reverse_proxy web:80
    }

    # API (also reachable directly on :8443 for integrations)
    handle /api/* {
        reverse_proxy api:8000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
