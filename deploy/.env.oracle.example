# Copy to deploy/.env.oracle on the Oracle VM. This file is intentionally
# ignored by Git. Never paste real values into GitHub, chat, or screenshots.
AAMS_HOSTNAME=choose-a-unique-name.duckdns.org
ALLOWED_ORIGINS=https://choose-a-unique-name.duckdns.org
ADMIN_EMAIL=your.name@srmist.edu.in
API_ADMIN_PASSWORD=replace-with-a-private-admin-password
AAMS_ACCESS_PASSWORD=replace-with-the-private-shared-member-password

# Telegram intentionally remains unset for this showcase deployment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
