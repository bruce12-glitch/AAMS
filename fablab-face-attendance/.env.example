# Telegram Configuration
# Optional: configure these privately, or use Communicate after signing in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security
AAMS_ENV=production
AAMS_ACCESS_PASSWORD=
QR_SECRET_KEY=your_random_secret_here
API_ADMIN_PASSWORD=your_admin_password_here
ADMIN_EMAIL=admin@srmist.edu.in
SESSION_SECRET_KEY=use_a_different_long_random_secret_here
SESSION_TTL_SECONDS=28800
# Comma-separated CORS origins (defaults to local dev servers)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_PATH=database/fablab.db
